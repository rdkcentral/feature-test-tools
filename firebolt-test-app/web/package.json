{
  "name": "firebolt-api-test-tool",
  "version": "1.0.0",
  "description": "Lightning-based web app for testing RDK8 Firebolt® API Specification",
  "main": "index.html",
  "scripts": {
    "prestart": "node scripts/ensure-lightning-cli-rollup.js",
    "start": "lng dev",
    "prebuild": "node scripts/ensure-lightning-cli-rollup.js",
    "build": "lng build",
    "postbuild": "node scripts/copy-favicon-ico.js",
    "serve": "npm run build && npx http-server build -p 9090 --cors",
    "test": "jest"
  },
  "keywords": [
    "lightning",
    "firebolt",
    "rdk8",
    "api-testing"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@firebolt-js/core-client": "^1.0.0-next.5",
    "@lightningjs/sdk": "^5.3.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@lightningjs/cli": "^2.2.0",
    "babel-jest": "^23.6.0",
    "jest": "^25.0.0",
    "jest-webgl-canvas-mock": "^2.5.3"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "resources": "usable"
    },
    "setupFiles": [
      "jest-webgl-canvas-mock"
    ],
    "moduleNameMapper": {
      "^src(.*)": "<rootDir>/src$1",
      "^test(.*)": "<rootDir>/test$1"
    },
    "transform": {
      "^.+\\.m?js$": "babel-jest"
    },
    "transformIgnorePatterns": []
  }
}
